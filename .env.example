# production = บังคับตั้ง WEB_ORIGIN และ DATABASE_URL (ค่าผิดรูปแบบทำให้แอปไม่เริ่มทำงาน)
NODE_ENV=development
PORT=4000

# origin ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย , ได้หลายค่า; ห้ามใช้ *)
WEB_ORIGIN="http://localhost:3000"

# จำนวน reverse proxy หน้าแอป (nginx / load balancer) — 0 เมื่อเปิดให้เรียกตรง
# ตั้งผิดจะทำให้ rate limit นับทุกคนเป็น IP เดียวกัน หรือถูกปลอม IP ได้
TRUST_PROXY_HOPS=0

# Rate limit ต่อ IP: จำนวน request สูงสุดภายในช่วงเวลา (มิลลิวินาที)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ระดับ log: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yard_control?schema=public"

# กุญแจเซ็น session cookie — อย่างน้อย 32 ตัวอักษร และบังคับตั้งใน production
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS=8

# งานตามเวลา (ยกเลิกการจองที่ไม่ชำระ, แจ้งเตือน) — รันหลาย instance ให้เปิดไว้ตัวเดียว
RUN_JOBS=true
QR_TTL_MINUTES=15
FINE_PAYMENT_DAYS=7
NOTIFY_BEFORE_MINUTES=15

# ตัวเชื่อมระบบภายนอก: ตอนนี้มีเฉพาะ mock (รอ spec จริง)
CRM_MODE=mock
PAYMENT_GATEWAY_MODE=mock

# รหัสผ่านของบัญชีพนักงานที่ npm run db:seed สร้าง (CS001, YD001, IT001)
SEED_EMPLOYEE_PASSWORD=""
# เซิร์ฟเวอร์ทดสอบ: ลูกค้าตัวอย่างที่ seed สร้างให้ (ไม่ตั้ง = ไม่สร้าง) — ใช้คู่กับ NEXT_PUBLIC_DEMO_* ของ frontend
SEED_DEMO_BUYER_PHONE=""
SEED_DEMO_GREEN_SHIRT_CARD=""
SEED_DEMO_GREEN_SHIRT_PHONE=""

# อัตราค่าบริการตั้งต้น (บาท / ช่อง / รอบ) — ใช้จนกว่าจะมีโมดูล Pricing
DEFAULT_PRICE_PER_SLOT_ROUND=100

# CRM (ตรวจสอบข้อมูลผู้ขอใช้บริการก่อนลงทะเบียน)
CRM_API_URL=""
CRM_API_KEY=""

# Payment Gateway กลาง (QR Payment)
PAYMENT_GATEWAY_URL=""
PAYMENT_GATEWAY_KEY=""
PAYMENT_WEBHOOK_SECRET=""
# รหัสเริ่มต้นของธุรกรรม (Transaction Prefix Code) — รอค่าจริงจากผู้ดูแล Payment Gateway
TRANSACTION_PREFIX="YCS"
