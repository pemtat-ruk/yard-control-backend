// Yard Control System (YCS) — ระบบลานจอดรถจัดเรียงสินค้า
// ตารางและคอลัมน์ตาม Program Specification_YCS – Data Dictionary (2) ของ SA
// ตารางที่ขึ้นต้นหมวดด้วย [เรา] = SA ยังไม่ได้ออกแบบ ใช้ของเราไปก่อน (docs/sa-schema-tasks.md)
// เวลา (datetime) เก็บเป็น UTC; วันที่ (Date) เป็นวันตามเวลาไทย

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// ───────────── ค่าคงที่ (Master data) ─────────────

model BookingType {
  id            BigInt    @id @default(autoincrement()) @map("ID")
  bookingType   String    @unique @map("BookingType") @db.Char(1) // S | L
  bookingTypeTh String?   @map("BookingType_Th") @db.NVarChar(500)
  bookingTypeEn String?   @map("BookingType_En") @db.NVarChar(500)
  isActive      Boolean   @default(true) @map("Is_Active")
  createdBy     String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate   DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  bookings BookingHeader[]

  @@map("BookingType")
}

model PaymentType {
  id            BigInt    @id @default(autoincrement()) @map("ID")
  paymentType   String    @unique @map("PaymentType") @db.Char(1) // F | D
  paymentTypeTh String?   @map("PaymentType_Th") @db.NVarChar(500)
  paymentTypeEn String?   @map("PaymentType_En") @db.NVarChar(500)
  isActive      Boolean   @default(true) @map("Is_Active")
  createdBy     String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate   DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  bookings BookingHeader[]

  @@map("PaymentType")
}

// รหัสเป็น nvarchar(30) ต่างจาก char(1) ในตารางที่อ้าง จึงไม่มี FK (docs/sa-schema-tasks.md)
model PaymentStatus {
  id              BigInt    @id @default(autoincrement()) @map("ID")
  paymentStatus   String    @unique @map("PaymentStatus") @db.NVarChar(30) // W | P | O | C
  paymentStatusTh String?   @map("PaymentStatus_Th") @db.NVarChar(500)
  paymentStatusEn String?   @map("PaymentStatus_En") @db.NVarChar(500)
  isActive        Boolean   @default(true) @map("Is_Active")
  createBy        String?   @map("CreateBy") @db.NVarChar(30)
  createDate      DateTime? @default(now()) @map("CreateDate") @db.DateTime

  @@map("PaymentStatus")
}

model BookingStatus {
  id            BigInt    @id @default(autoincrement()) @map("ID")
  bookingStatus String    @unique @map("BookingStatus") @db.Char(1) // A | C
  bookingTh     String?   @map("Booking_Th") @db.NVarChar(500)
  bookingEn     String?   @map("Booking_En") @db.NVarChar(500)
  isActive      Boolean   @default(true) @map("Is_Active")
  createBy      String?   @map("CreateBy") @db.NVarChar(30)
  createDate    DateTime? @default(now()) @map("CreateDate") @db.DateTime

  bookings BookingHeader[]

  @@map("BookingStatus")
}

model ColorsStatus {
  id            BigInt    @id @default(autoincrement()) @map("ID")
  colorCode     String    @unique @map("ColorCode") @db.Char(1) // G | R | B | Y | S
  colorTh       String?   @map("Color_Th") @db.NVarChar(500)
  colorEn       String?   @map("Color_En") @db.NVarChar(500)
  description   String?   @map("Description") @db.NVarChar(500)
  htmlColorCode String?   @map("HtmlColorCode") @db.NVarChar(500)
  isActive      Boolean   @default(true) @map("Is_Active")
  createBy      String?   @map("CreateBy") @db.NVarChar(30)
  createDate    DateTime? @default(now()) @map("CreateDate") @db.DateTime

  @@map("ColorsStatus")
}

// ───────────── ผู้ใช้และสิทธิ์ ─────────────

// ข้อมูลพนักงานของบริษัท — บน server จริงเป็น view ของบริษัท; เครื่อง dev สร้างเป็นตารางจำลองชื่อเดียวกัน
model EmployeeView {
  empCode     String  @id @map("EmpCode") @db.NVarChar(30)
  username    String  @unique @map("Username") @db.NVarChar(100)
  password    String? @map("Password") @db.NVarChar(512)
  empName     String  @map("EmpName") @db.NVarChar(255)
  deptCode    String? @map("DeptCode") @db.NVarChar(50)
  deptName    String? @map("DeptName") @db.NVarChar(255)
  supDeptName String? @map("SupDeptName") @db.NVarChar(255)
  empPosition String? @map("EmpPosition") @db.NVarChar(255)
  empEmail    String? @map("EmpEmail") @db.NVarChar(255)
  shortName   String? @map("ShortName") @db.NVarChar(100)
  empStatus   String? @map("EmpStatus") @db.NVarChar(30)
  userLevel   Int?    @map("User_Level")

  @@map("vwEmployee_List")
}

model Roles {
  roleId          BigInt    @id @default(autoincrement()) @map("RoleID")
  roleName        String    @map("RoleName") @db.NVarChar(500)
  roleDescription String?   @map("RoleDescription") @db.NVarChar(500)
  isActive        Boolean   @default(true) @map("Is_Active")
  createdBy       String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate     DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  permissions Role_Permission_Matrix[]
  accounts    Accounts_Roles[]

  @@map("Roles")
}

// ค่าตอนนี้ยังเป็นสิทธิ์รายฟังก์ชันของระบบ (auth/domain/permissions.ts) — รหัสตามเมนูของ SA (can_view_...) รอย้ายทีหลัง
// Description / SequenceNo / MenuID / MenuSubID ตาม Data Dictionary (พ.ย. 2569)
model Permission_Actions {
  actionId    BigInt    @id @default(autoincrement()) @map("ActionID")
  actionCode  String    @unique @map("ActionCode") @db.VarChar(50)
  actionName  String?   @map("ActionName") @db.NVarChar(500)
  description String?   @map("Description") @db.NVarChar(500)
  sequenceNo  Int?      @map("SequenceNo")
  menuId      BigInt?   @map("MenuID")
  menuSubId   BigInt?   @map("MenuSubID")
  isActive    Boolean   @default(true) @map("Is_Active")
  createdBy   String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  roles Role_Permission_Matrix[]

  @@map("Permission_Actions")
}

model Role_Permission_Matrix {
  id          BigInt    @id @default(autoincrement()) @map("ID")
  roleId      BigInt    @map("RoleID")
  menuId      BigInt?   @map("MenuID") // ตาม Data Dictionary — ยังไม่ใช้ตรวจสิทธิ์
  menuSubId   BigInt?   @map("MenuSubID")
  actionId    BigInt    @map("ActionID")
  createdBy   String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  role   Roles              @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)
  action Permission_Actions @relation(fields: [actionId], references: [actionId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, actionId])
  @@map("Role_Permission_Matrix")
}

// กลุ่มสิทธิ์ของพนักงาน (เอกสารเขียนว่า RoleID อ้าง Permission_Actions น่าจะพิมพ์ผิด จึงอ้าง Roles)
model Accounts_Roles {
  id          BigInt    @id @default(autoincrement()) @map("ID")
  empCode     String    @map("EmpCode") @db.NVarChar(100)
  roleId      BigInt    @map("RoleID")
  createdBy   String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  role Roles @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([empCode, roleId])
  @@map("Accounts_Roles")
}

// [เรา] ใส่รหัสผ่านผิดติดกันครบจำนวน = ล็อกชั่วคราวถึง LockedUntil; เข้าสำเร็จแล้วนับใหม่
model LoginAttempt {
  loginKey     String    @id @map("LoginKey") @db.NVarChar(100)
  failedLogins Int       @default(0) @map("FailedLogins")
  lockedUntil  DateTime? @map("LockedUntil")

  @@map("LoginAttempt")
}

model Menu_Groups {
  menuId      BigInt    @id @default(autoincrement()) @map("MenuID")
  menuNameTh  String?   @map("Menu_Name_Th") @db.NVarChar(500)
  menuNameEn  String?   @map("Menu_Name_En") @db.NVarChar(500)
  routePath   String?   @map("Route_Path") @db.NVarChar(500)
  icon        String?   @map("Icon") @db.NVarChar(30)
  sequenceNo  Int?      @map("SequenceNo")
  isActive    Boolean   @default(true) @map("Is_Active")
  createdBy   String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  subGroups Menu_Sub_Groups[]

  @@map("Menu_Groups")
}

model Menu_Sub_Groups {
  menuSubId     BigInt    @id @default(autoincrement()) @map("MenuSubID")
  menuSubNameTh String?   @map("Menu_Sub_Name_Th") @db.NVarChar(500)
  menuSubNameEn String?   @map("Menu_Sub_Name_En") @db.VarChar(500)
  routePath     String?   @map("Route_Path") @db.VarChar(500)
  icon          String?   @map("Icon") @db.NVarChar(30)
  sequenceNo    Int?      @map("SequenceNo")
  isActive      Boolean   @default(true) @map("Is_Active")
  menuId        BigInt    @map("MenuID")
  createdBy     String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate   DateTime? @default(now()) @map("CreatedDate") @db.DateTime
  updatedBy     String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate   DateTime? @map("UpdatedDate") @db.DateTime

  menu Menu_Groups @relation(fields: [menuId], references: [menuId], onDelete: NoAction, onUpdate: NoAction)

  @@map("Menu_Sub_Groups")
}

// ผู้ขอใช้บริการ: แรงงาน (Labor) และผู้ซื้อ (buyer) — ข้อมูลส่วนใหญ่มาจาก CRM DB
// เอกสารทำเครื่องหมาย PK ไว้ 3 คอลัมน์: ใช้ ID เป็น PK, CusId / LaborCode / Telephone เป็น unique
model CRMCustomer {
  id                      BigInt    @id @default(autoincrement()) @map("ID")
  cusId                   String    @unique @map("CusId") @db.NVarChar(6) // C00001
  cusType                 String?   @map("CusType") @db.NVarChar(100) // Labor | buyer
  laborCode               String?   @unique @map("LaborCode") @db.VarChar(20)
  laborCoat               String?   @map("LaborCoat") @db.VarChar(10)
  laborOrigin             String?   @map("LaborOrigin") @db.VarChar(20)
  laborCountry            String?   @map("LaborCountry") @db.VarChar(20)
  laborColor              String?   @map("LaborColor") @db.VarChar(20)
  laborStatus             String?   @map("LaborStatus") @db.VarChar(20)
  coatNo                  Int?      @map("CoatNo")
  telephone               String?   @unique @map("Telephone") @db.NVarChar(200)
  firstName               String?   @map("FirstName") @db.NVarChar(200)
  lastName                String?   @map("LastName") @db.NVarChar(200)
  buyerType               String?   @map("BuyerType") @db.NVarChar(100)
  buyerNumberPlate        String?   @map("BuyerNumberPlate") @db.NVarChar(50)
  buyerProvinceToSell     String?   @map("BuyerProvinceToSell") @db.NVarChar(200)
  buyerProvinceCar        String?   @map("BuyerProvinceCar") @db.NVarChar(100)
  buyerInterestedProducts String?   @map("BuyerInterestedProducts") @db.NVarChar(300)
  isActive                Boolean   @default(true) @map("Is_Active")
  createdBy               String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate             DateTime? @default(now()) @map("CreatedDate") @db.DateTime
  updatedBy               String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate             DateTime? @map("UpdatedDate") @db.DateTime

  bookings BookingHeader[]

  @@map("CRMCustomer")
}

// ───────────── ลานจอด ช่องจอด รอบ ราคา ─────────────

model Parking {
  parkingId   BigInt    @id @default(autoincrement()) @map("ParkingID")
  parkingName String    @map("ParkingName") @db.NVarChar(500)
  isActive    Boolean   @default(true) @map("Is_Active") // เปิด/ปิดลาน
  createdBy   String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  extra    ParkingExtra?
  slots    ParkingSlot[]
  versions ParkingLayoutVersion[]

  @@map("Parking")
}

// [เรา] รหัสลาน (ใช้ทำป้ายช่อง เช่น P5-12) ลำดับแสดง การลบลาน และผังที่แอดมินแก้ (JSON)
// Layout ว่าง = ใช้ผังตั้งต้นใน yard/domain/lot-layouts.ts
model ParkingExtra {
  parkingId BigInt    @id @map("ParkingID")
  code      String    @unique @map("Code") @db.NVarChar(20)
  sortOrder Int       @default(0) @map("SortOrder")
  layout    String?   @map("Layout") @db.NVarChar(Max)
  deletedAt DateTime? @map("DeletedAt")

  parking Parking @relation(fields: [parkingId], references: [parkingId], onDelete: NoAction, onUpdate: NoAction)

  @@map("ParkingExtra")
}

model ParkingSlot {
  parkingSlotId BigInt    @id @default(autoincrement()) @map("ParkingSlotID")
  parkingId     BigInt    @map("ParkingID")
  slot          String    @map("Slot") @db.NVarChar(30)
  // false = ช่องถูกลบ (เก็บแถวไว้ให้การจองเก่าอ้างถึงได้) — ปิด/สงวนสิทธิ์อยู่ใน ParkingSlotControl
  isActive      Boolean   @default(true) @map("Is_Active")
  createdBy     String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate   DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  parking     Parking              @relation(fields: [parkingId], references: [parkingId], onDelete: NoAction, onUpdate: NoAction)
  controls    ParkingSlotControl[]
  bookings    BookingDetail[]
  inspections SlotInspection[]

  @@unique([parkingId, slot])
  @@map("ParkingSlot")
}

// ควบคุมสถานะช่องที่ตั้งด้วยมือ: ปิด (CLOSED) / สงวนสิทธิ์ (RESERVED) ตั้งแต่ StartDateTime ถึง EndDateTime
// EndDateTime ว่าง = ไม่มีกำหนดสิ้นสุด; RoundID ว่าง = ทุกรอบ — เลิกตั้งสถานะ = ใส่ EndDateTime (เก็บประวัติไว้)
model ParkingSlotControl {
  id             BigInt    @id @default(autoincrement()) @map("ID")
  parkingSlotId  BigInt    @map("ParkingSlotID")
  slotStatusCode String    @map("SlotStatusCode") @db.NVarChar(500)
  startDateTime  DateTime  @map("StartDateTime") @db.DateTime
  endDateTime    DateTime? @map("EndDateTime") @db.DateTime
  roundId        BigInt?   @map("RoundID")
  reason         String?   @map("Reason") @db.NVarChar(500)
  isActive       Boolean   @default(true) @map("Is_Active")
  createdBy      String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate    DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  slot   ParkingSlot       @relation(fields: [parkingSlotId], references: [parkingSlotId], onDelete: NoAction, onUpdate: NoAction)
  status ParkingSlotStatus @relation(fields: [slotStatusCode], references: [statusCode], onDelete: NoAction, onUpdate: NoAction)
  round  BookingRound?     @relation(fields: [roundId], references: [roundId], onDelete: NoAction, onUpdate: NoAction)

  @@index([parkingSlotId, isActive])
  @@map("ParkingSlotControl")
}

// เวอร์ชันของลาน: ชุดรอบ (RoundNo) + ราคา ที่มีผลตั้งแต่ EffectiveDate (ช่องของการจองอ้าง ParkingSlot ตรง ๆ)
// RoundNo ใน BookingRound ซ้ำได้ (หลายรอบต่อชุด) จึงไม่มี FK — ตรวจในโค้ด
model ParkingLayoutVersion {
  parkingLayoutId BigInt    @id @default(autoincrement()) @map("ParkingLayoutID")
  parkingId       BigInt    @map("ParkingID")
  roundNo         String    @map("RoundNo") @db.VarChar(13)
  versionNo       String    @map("VersionNo") @db.NVarChar(30)
  effectiveDate   DateTime  @map("EffectiveDate") @db.DateTime
  isActive        Boolean   @default(true) @map("Is_Active")
  createdBy       String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate     DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  parking Parking       @relation(fields: [parkingId], references: [parkingId], onDelete: NoAction, onUpdate: NoAction)
  rates   ParkingRate[]

  @@index([parkingId, effectiveDate])
  @@map("ParkingLayoutVersion")
}

// สถานะช่องจอด 5 สถานะพร้อมสี (Data Dictionary + Master data พ.ย. 2569) — เป็นข้อมูลอ้างอิง
// สถานะที่ใช้งานจริงคำนวณใน yard/domain/slot-status.ts และหน้าเว็บใช้สีของระบบเอง (สีในตารางนี้ไม่ใช้วาดผัง)
// StatusName_EN ในเอกสารเขียนความยาว 1 น่าจะพิมพ์ผิด จึงใช้ 500 ตามชนิดข้อมูล
model ParkingSlotStatus {
  id            BigInt    @id @default(autoincrement()) @map("ID")
  statusCode    String    @unique @map("StatusCode") @db.NVarChar(500) // AVAILABLE | OCCUPIED | CLOSED | OVERTIME | RESERVED
  statusNameTh  String?   @map("StatusName_TH") @db.NVarChar(500)
  statusNameEn  String?   @map("StatusName_EN") @db.NVarChar(500)
  description   String?   @map("Description") @db.NVarChar(500)
  colorTh       String?   @map("Color_Th") @db.NVarChar(500)
  colorEn       String?   @map("Color_En") @db.NVarChar(500)
  htmlColorCode String?   @map("HtmlColorCode") @db.NVarChar(500)
  isActive      Boolean   @default(true) @map("Is_Active")
  createdBy     String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate   DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  controls ParkingSlotControl[]

  @@map("ParkingSlotStatus")
}

model ParkingRate {
  parkingRateId   BigInt    @id @default(autoincrement()) @map("ParkingRateID")
  parkingLayoutId BigInt    @map("ParkingLayoutID")
  rateAmount      Decimal   @map("RateAmount") @db.Decimal(10, 2) // ราคาต่อช่องต่อรอบ
  isActive        Boolean   @default(true) @map("Is_Active")
  createdBy       String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate     DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  version ParkingLayoutVersion @relation(fields: [parkingLayoutId], references: [parkingLayoutId], onDelete: NoAction, onUpdate: NoAction)

  @@index([parkingLayoutId])
  @@map("ParkingRate")
}

// 1 แถว = 1 รอบในชุดรอบ RoundNo (R2026-11-0001); ชุดรอบมีผลตั้งแต่ EffectiveDate
model BookingRound {
  roundId       BigInt    @id @default(autoincrement()) @map("RoundID")
  roundNo       String    @map("RoundNo") @db.VarChar(13)
  roundSequence Int       @map("RoundSequence") // 1 = รอบแรกของวันบริการ
  startTime     DateTime  @map("StartTime") @db.Time
  endTime       DateTime  @map("EndTime") @db.Time
  durationHour  Int       @map("DurationHour")
  effectiveDate DateTime  @map("EffectiveDate") @db.DateTime
  isActive      Boolean   @default(true) @map("Is_Active")
  createBy      String?   @map("CreateBy") @db.NVarChar(30)
  createDate    DateTime? @default(now()) @map("CreateDate") @db.DateTime

  bookings     BookingDetail[]
  slotControls ParkingSlotControl[]

  @@unique([roundNo, roundSequence])
  @@map("BookingRound")
}

model BookingPolicy {
  id          BigInt    @id @default(autoincrement()) @map("ID")
  policyCode  String    @unique @map("PolicyCode") @db.VarChar(30)
  policyValue Int       @map("PolicyValue")
  unit        String?   @map("Unit") @db.VarChar(20)
  isActive    Boolean   @default(true) @map("Is_Active")
  createBy    String?   @map("CreateBy") @db.VarChar(30)
  createDate  DateTime? @default(now()) @map("CreateDate") @db.DateTime

  @@map("BookingPolicy")
}

// NotiType ในเอกสารเป็น varchar(10) แต่ค่า PARKING_END_CUSTOMER ยาว 20 ตัว จึงใช้ 30
model NotificationSetting {
  notiId           BigInt    @id @default(autoincrement()) @map("NotiID")
  notiType         String    @map("NotiType") @db.VarChar(30) // PAYMENT_DUE | PARKING_END_CUSTOMER | PARKING_END_INSPECTOR
  notiNameTh       String?   @map("NotiName_TH") @db.NVarChar(500)
  // Data Dictionary (พ.ย. 2569) ระบุผู้รับเป็น RoleID — ลูกค้าไม่มีกลุ่มสิทธิ์ในระบบ จึงยังเก็บ RecipientType คู่กัน
  roleId           BigInt?   @map("RoleID")
  recipientType    String?   @map("RecipientType") @db.NVarChar(50) // CUSTOMER | EMPLOYEE
  referTime        DateTime? @map("ReferTime") @db.Time
  notiBeforeMinute Int?      @map("NotiBeforeMinute")
  effectiveDate    DateTime? @map("EffectiveDate") @db.DateTime
  isActive         Boolean   @default(true) @map("Is_Active")
  createBy         String?   @map("CreateBy") @db.NVarChar(30)
  createDate       DateTime? @default(now()) @map("CreateDate") @db.DateTime

  schedules PaymentSchedule[]

  @@index([notiType, effectiveDate])
  @@map("NotificationSetting")
}

// ───────────── การจอง ─────────────

model DocumentRunnings {
  runningId   BigInt    @id @default(autoincrement()) @map("RunningID")
  prefix      String    @map("Prefix") @db.Char(2)
  year        String    @map("Year") @db.NVarChar(4)
  month       String    @map("Month") @db.NVarChar(2)
  lastNumber  Int       @map("LastNumber")
  createdBy   String?   @map("CreatedBy") @db.NVarChar(30)
  createdDate DateTime? @default(now()) @map("CreatedDate") @db.DateTime

  @@unique([prefix, year, month])
  @@map("DocumentRunnings")
}

model BookingHeader {
  bookingNo      String    @id @map("BookingNo") @db.VarChar(14) // BK2026-11-0001
  bookingDate    DateTime  @default(now()) @map("BookingDate") @db.DateTime
  bookingCusId   String    @map("BookingCusId") @db.NVarChar(6)
  bookingChannel String    @map("BookingChannel") @db.Char(1) // N = จองปกติ | I = นำเข้าไฟล์
  bookingType    String    @map("BookingType") @db.Char(1) // S | L
  paymentType    String    @map("PaymentType") @db.Char(1) // F | D
  paymentStatus  String    @map("PaymentStatus") @db.Char(1) // W | P | O | C
  bookingStatus  String    @map("BookingStatus") @db.Char(1) // A | C
  totalAmount    Decimal   @map("TotalAmount") @db.Decimal(10, 2)
  paidAt         DateTime? @map("PaidAt") @db.DateTime
  createdBy      String    @map("CreatedBy") @db.NVarChar(30) // EmpCode หรือ CusId เมื่อลูกค้าจองเอง
  createdDate    DateTime  @default(now()) @map("CreatedDate") @db.DateTime
  bookingRemark  String?   @map("BookingRemark") @db.NVarChar(500)
  updatedBy      String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate    DateTime? @map("UpdatedDate") @db.DateTime

  customer     CRMCustomer          @relation(fields: [bookingCusId], references: [cusId], onDelete: NoAction, onUpdate: NoAction)
  type         BookingType          @relation(fields: [bookingType], references: [bookingType], onDelete: NoAction, onUpdate: NoAction)
  payment      PaymentType          @relation(fields: [paymentType], references: [paymentType], onDelete: NoAction, onUpdate: NoAction)
  status       BookingStatus        @relation(fields: [bookingStatus], references: [bookingStatus], onDelete: NoAction, onUpdate: NoAction)
  details      BookingDetail[]
  schedules    PaymentSchedule[]
  transactions PaymentTransaction[]
  fines        Fine[]
  inspections  SlotInspection[]

  @@index([bookingCusId, bookingStatus])
  @@index([bookingStatus, paymentStatus])
  @@map("BookingHeader")
}

// 1 แถว = 1 ช่อง × 1 วันใช้งาน × 1 รอบ
// การจองที่ยกเลิกยังเก็บแถวไว้ จึงกันจองซ้อนด้วยการล็อกแถว ParkingSlot ตอนจอง (booking.service) ไม่ใช่ unique
model BookingDetail {
  bookingDetailId     BigInt    @id @default(autoincrement()) @map("BookingDetailID")
  bookingNo           String    @map("BookingNo") @db.VarChar(14)
  usageDate           DateTime  @map("UsageDate") @db.Date
  parkingSlotId       BigInt    @map("ParkingSlotID")
  roundId             BigInt    @map("RoundID")
  amount              Decimal   @map("Amount") @db.Decimal(10, 2) // ราคา ณ วันที่จอง
  paidAt              DateTime? @map("PaidAt") @db.DateTime
  remark              String?   @map("Remark") @db.NVarChar(500)
  updatedBy           String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate         DateTime? @map("UpdatedDate") @db.DateTime

  booking    BookingHeader     @relation(fields: [bookingNo], references: [bookingNo], onDelete: NoAction, onUpdate: NoAction)
  slot       ParkingSlot       @relation(fields: [parkingSlotId], references: [parkingSlotId], onDelete: NoAction, onUpdate: NoAction)
  round      BookingRound      @relation(fields: [roundId], references: [roundId], onDelete: NoAction, onUpdate: NoAction)
  schedules  PaymentSchedule[]
  fines      Fine[]

  @@index([parkingSlotId, usageDate, roundId])
  @@index([bookingNo])
  @@index([usageDate])
  @@map("BookingDetail")
}

// งวดชำระวันต่อวัน: 1 แถวต่อ 1 วันใช้งานของใบจอง (ชำระทั้งใบ ไม่ใช่รายช่อง — รอ SA ยืนยัน)
// BookingDetailID = แถวแรกของวันนั้น (บอกว่างวดนี้เป็นของวันใช้งานไหน), DueDate + DueTime = กำหนดชำระตามเวลาไทย
model PaymentSchedule {
  payScheduleId   BigInt    @id @default(autoincrement()) @map("PayScheduleID")
  bookingDetailId BigInt?   @map("BookingDetailID")
  bookingNo       String    @map("BookingNo") @db.VarChar(14)
  sequenceNo      Int       @map("SequenceNo")
  notiId          BigInt?   @map("NotiID")
  dueDate         DateTime  @map("DueDate") @db.Date
  dueTime         DateTime  @map("DueTime") @db.Time
  reminder        DateTime? @map("Reminder") @db.DateTime
  amountDue       Decimal   @map("AmountDue") @db.Decimal(10, 2)
  paymentStatus   String    @map("PaymentStatus") @db.VarChar(1) // W | P | O | C
  paidAt          DateTime? @map("PaidAt") @db.DateTime
  remark          String?   @map("Remark") @db.NVarChar(500)
  createdBy       String    @map("CreatedBy") @db.NVarChar(30)
  createdDate     DateTime  @default(now()) @map("CreatedDate") @db.DateTime
  updatedBy       String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate     DateTime? @map("UpdatedDate") @db.DateTime

  detail       BookingDetail?        @relation(fields: [bookingDetailId], references: [bookingDetailId], onDelete: NoAction, onUpdate: NoAction)
  booking      BookingHeader         @relation(fields: [bookingNo], references: [bookingNo], onDelete: NoAction, onUpdate: NoAction)
  notification NotificationSetting?  @relation(fields: [notiId], references: [notiId], onDelete: NoAction, onUpdate: NoAction)
  transactions PaymentScheduleItem[]

  @@unique([bookingNo, sequenceNo])
  @@index([paymentStatus, dueDate])
  @@map("PaymentSchedule")
}

// ───────────── ประวัติการจอง (Data Dictionary พ.ย. 2569) ─────────────
// สำเนาใบจอง + รายการย่อย + งวดชำระ ก่อนแก้ไขทุกครั้ง (booking/booking-history.ts)
// HistoryGroupID นับต่อใบจอง: ครั้งแรก 1 ครั้งถัดไป +1 — ตารางรายการย่อย/งวดอ้างชุดเดียวกันด้วย BookingNo + HistoryGroupID
// [ถาม SA] เอกสารไม่ระบุว่านับต่อใบจองหรือทั้งระบบ และไม่ได้กำหนดว่าแก้อะไรบ้างจึงเก็บประวัติ
// ไม่ผูก FK กับตารางหลัก: ประวัติต้องอยู่ได้แม้ข้อมูลหลักเปลี่ยน

model BookingHeaderHistory {
  id             BigInt    @id @default(autoincrement()) @map("ID")
  historyGroupId Int       @map("HistoryGroupID")
  bookingNo      String    @map("BookingNo") @db.VarChar(14)
  bookingDate    DateTime  @map("BookingDate") @db.DateTime
  bookingCusId   String    @map("BookingCusId") @db.NVarChar(6)
  bookingChannel String    @map("BookingChannel") @db.Char(1)
  bookingType    String    @map("BookingType") @db.Char(1)
  paymentType    String    @map("PaymentType") @db.Char(1)
  paymentStatus  String    @map("PaymentStatus") @db.Char(1)
  bookingStatus  String    @map("BookingStatus") @db.Char(1)
  totalAmount    Decimal   @map("TotalAmount") @db.Decimal(10, 2)
  paidAt         DateTime? @map("PaidAt") @db.DateTime
  createdBy      String    @map("CreatedBy") @db.NVarChar(30)
  createdDate    DateTime  @map("CreatedDate") @db.DateTime
  bookingRemark  String?   @map("BookingRemark") @db.NVarChar(500)
  updatedBy      String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate    DateTime? @map("UpdatedDate") @db.DateTime

  @@unique([bookingNo, historyGroupId])
  @@map("BookingHeaderHistory")
}

model BookingDetailHistory {
  id                  BigInt    @id @default(autoincrement()) @map("ID")
  historyGroupId      Int       @map("HistoryGroupID")
  bookingDetailId     BigInt    @map("BookingDetailID")
  bookingNo           String    @map("BookingNo") @db.VarChar(14)
  usageDate           DateTime  @map("UsageDate") @db.Date
  parkingSlotId       BigInt    @map("ParkingSlotID")
  roundId             BigInt    @map("RoundID")
  amount              Decimal   @map("Amount") @db.Decimal(10, 2)
  paidAt              DateTime? @map("PaidAt") @db.DateTime
  remark              String?   @map("Remark") @db.NVarChar(500)
  updatedBy           String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate         DateTime? @map("UpdatedDate") @db.DateTime

  @@index([bookingNo, historyGroupId])
  @@map("BookingDetailHistory")
}

model PaymentScheduleHistory {
  id              BigInt    @id @default(autoincrement()) @map("ID")
  historyGroupId  Int       @map("HistoryGroupID")
  payScheduleId   BigInt    @map("PayScheduleID")
  bookingDetailId BigInt?   @map("BookingDetailID")
  bookingNo       String    @map("BookingNo") @db.VarChar(14)
  sequenceNo      Int       @map("SequenceNo")
  notiId          BigInt?   @map("NotiID")
  dueDate         DateTime  @map("DueDate") @db.Date
  dueTime         DateTime  @map("DueTime") @db.Time
  reminder        DateTime? @map("Reminder") @db.DateTime
  amountDue       Decimal   @map("AmountDue") @db.Decimal(10, 2)
  paymentStatus   String    @map("PaymentStatus") @db.VarChar(1)
  paidAt          DateTime? @map("PaidAt") @db.DateTime
  remark          String?   @map("Remark") @db.NVarChar(500)
  createdBy       String    @map("CreatedBy") @db.NVarChar(30)
  createdDate     DateTime  @map("CreatedDate") @db.DateTime
  updatedBy       String?   @map("UpdatedBy") @db.NVarChar(30)
  updatedDate     DateTime? @map("UpdatedDate") @db.DateTime

  @@index([bookingNo, historyGroupId])
  @@map("PaymentScheduleHistory")
}

// ───────────── [เรา] การชำระเงินผ่าน QR และใบเสร็จ — รอ spec Payment Gateway ─────────────

model PaymentTransaction {
  id            Int       @id @default(autoincrement()) @map("ID")
  transactionNo String    @unique @map("TransactionNo") @db.NVarChar(50) // ขึ้นต้นด้วยรหัสธุรกรรมของ YCS
  purpose       String    @default("BOOKING") @map("Purpose") @db.VarChar(30) // BOOKING | FINE
  bookingNo     String?   @map("BookingNo") @db.VarChar(14)
  amount        Decimal   @map("Amount") @db.Decimal(10, 2)
  status        String    @default("PENDING") @map("Status") @db.VarChar(30) // PENDING | PAID | EXPIRED
  qrPayload     String?   @map("QrPayload") @db.NVarChar(Max)
  gatewayRef    String?   @unique @map("GatewayRef") @db.NVarChar(100)
  expiresAt     DateTime  @map("ExpiresAt")
  paidAt        DateTime? @map("PaidAt")
  createdDate   DateTime  @default(now()) @map("CreatedDate")
  updatedDate   DateTime  @updatedAt @map("UpdatedDate")

  booking   BookingHeader?        @relation(fields: [bookingNo], references: [bookingNo], onDelete: NoAction, onUpdate: NoAction)
  schedules PaymentScheduleItem[]
  receipt   Receipt?
  fine      Fine?

  @@index([status, expiresAt])
  @@index([bookingNo])
  @@map("PaymentTransaction")
}

// งวดชำระที่ธุรกรรม QR หนึ่งครั้งครอบคลุม
model PaymentScheduleItem {
  paymentId     Int    @map("PaymentID")
  payScheduleId BigInt @map("PayScheduleID")

  payment  PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule PaymentSchedule    @relation(fields: [payScheduleId], references: [payScheduleId], onDelete: NoAction, onUpdate: NoAction)

  @@id([paymentId, payScheduleId])
  @@index([payScheduleId])
  @@map("PaymentScheduleItem")
}

// ใบกำกับภาษีอย่างย่อ: เก็บภาษี ณ วันที่ออก
model Receipt {
  id              Int      @id @default(autoincrement()) @map("ID")
  receiptNo       String   @unique @map("ReceiptNo") @db.NVarChar(30)
  paymentId       Int      @unique @map("PaymentID")
  vatRatePercent  Decimal  @map("VatRatePercent") @db.Decimal(5, 2)
  amountBeforeVat Decimal  @map("AmountBeforeVat") @db.Decimal(10, 2)
  vatAmount       Decimal  @map("VatAmount") @db.Decimal(10, 2)
  issuedAt        DateTime @default(now()) @map("IssuedAt")

  payment PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Receipt")
}

// ───────────── ค่าปรับ (Data Dictionary) ─────────────

// ค่าปรับ 1 ใบ = 1 ช่อง: ผูกกับ BookingDetail ของรอบสุดท้ายที่จบก่อนจอดเกิน (Data Dictionary — SA ยืนยัน 10 พ.ย. 2569)
// ยังไม่มี FineRate / PaymentStatus / Blacklist ตามเอกสาร (รอ SA บอกหน่วยของอัตราค่าปรับ) — สถานะชำระอ่านจาก PaymentTransaction
model Fine {
  id              Int       @id @default(autoincrement()) @map("ID")
  fineNo          String    @unique @map("FineNo") @db.NVarChar(30)
  cusId           String?   @map("CusId") @db.NVarChar(6)
  bookingNo       String?   @map("BookingNo") @db.VarChar(14)
  bookingDetailId BigInt    @map("BookingDetailID")
  endDateTime     DateTime? @map("EndDateTime") @db.DateTime // สิทธิ์จอดสิ้นสุดเมื่อไร
  overtimeMinute  Int?      @map("OvertimeMinute") // เกินกี่นาที ณ ตอนบันทึก
  issuedBy        String    @map("IssuedBy") @db.NVarChar(30) // EmpCode
  reason          String    @map("Reason") @db.NVarChar(500)
  amount          Decimal   @map("Amount") @db.Decimal(10, 2)
  paymentId       Int?      @unique @map("PaymentID")
  createdDate     DateTime  @default(now()) @map("CreatedDate")

  booking BookingHeader?      @relation(fields: [bookingNo], references: [bookingNo], onDelete: NoAction, onUpdate: NoAction)
  detail  BookingDetail       @relation(fields: [bookingDetailId], references: [bookingDetailId], onDelete: NoAction, onUpdate: NoAction)
  payment PaymentTransaction? @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cusId])
  @@index([bookingNo])
  @@index([bookingDetailId])
  @@map("Fine")
}

// ───────────── [เรา] ผลตรวจหน้างาน ─────────────

// ไม่มีแถว VACATED = ยังไม่ยืนยันว่ารถออก (ช่องยังเป็นสีเหลือง)
model SlotInspection {
  id            Int      @id @default(autoincrement()) @map("ID")
  parkingSlotId BigInt   @map("ParkingSlotID")
  bookingNo     String   @map("BookingNo") @db.VarChar(14)
  usageDate     DateTime @map("UsageDate") @db.Date
  result        String   @map("Result") @db.VarChar(30) // VACATED | STILL_PARKED
  inspectedBy   String   @map("InspectedBy") @db.NVarChar(30) // EmpCode
  createdDate   DateTime @default(now()) @map("CreatedDate")

  slot    ParkingSlot   @relation(fields: [parkingSlotId], references: [parkingSlotId], onDelete: NoAction, onUpdate: NoAction)
  booking BookingHeader @relation(fields: [bookingNo], references: [bookingNo], onDelete: NoAction, onUpdate: NoAction)

  @@index([parkingSlotId, usageDate])
  @@map("SlotInspection")
}

// ───────────── [เรา] แจ้งเตือนที่ส่งแล้ว / ตั้งค่า / ประวัติการใช้งาน ─────────────

model NotificationLog {
  id            Int       @id @default(autoincrement()) @map("ID")
  recipientType String    @map("RecipientType") @db.VarChar(30) // CUSTOMER | EMPLOYEE
  recipientCode String    @map("RecipientCode") @db.NVarChar(30) // CusId หรือ EmpCode
  type          String    @map("Type") @db.VarChar(30) // PARKING_EXPIRING | PARKING_OVERTIME | PAYMENT_DUE | BOOKING_CANCELLED
  title         String    @map("Title") @db.NVarChar(255)
  body          String    @map("Body") @db.NVarChar(Max)
  dedupeKey     String?   @unique @map("DedupeKey") @db.NVarChar(150) // กันส่งซ้ำ
  readAt        DateTime? @map("ReadAt")
  createdDate   DateTime  @default(now()) @map("CreatedDate")

  @@index([recipientType, recipientCode, readAt])
  @@map("NotificationLog")
}

// ค่าที่ไม่ใช่ตัวเลข จึงเก็บใน BookingPolicy ไม่ได้ (รหัสนำหน้าธุรกรรม)
model SystemSetting {
  key         String   @id @map("SettingKey") @db.NVarChar(100)
  value       String   @map("SettingValue") @db.NVarChar(Max)
  updatedBy   String?  @map("UpdatedBy") @db.NVarChar(30)
  updatedDate DateTime @updatedAt @map("UpdatedDate")

  @@map("SystemSetting")
}

model AuditLog {
  id          Int      @id @default(autoincrement()) @map("ID")
  actorCode   String?  @map("ActorCode") @db.NVarChar(30) // EmpCode หรือ CusId
  action      String   @map("Action") @db.NVarChar(100)
  entity      String   @map("Entity") @db.NVarChar(100)
  entityId    String?  @map("EntityID") @db.NVarChar(100)
  detail      String?  @map("Detail") @db.NVarChar(Max)
  createdDate DateTime @default(now()) @map("CreatedDate")

  @@index([entity, entityId])
  @@index([createdDate])
  @@map("AuditLog")
}
